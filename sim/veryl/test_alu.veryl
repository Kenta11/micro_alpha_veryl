#[test(test_alu_add_without_carry_then_overflow)]
module test_alu_add_without_carry_then_overflow {
    import alu_pkg::*;
    import machine_data_pkg::*;

    inst u_clock: $tb::clock_gen;

    var operation: alu_operation_t      ;
    var left     : micro1_machine_word_t;
    var right    : micro1_machine_word_t;
    var cin      : logic                ;
    var result   : micro1_machine_word_t;
    var cout     : logic                ;

    inst dut: alu ( operation, left, right, cin, result, cout );

    initial {
        operation = alu_operation_t::ADD;
        left      = 16'hFFF3;
        right     = 16'h000E;
        cin       = 1'b0;

        u_clock.next(1);

        $assert(result == 16'd1);
        $assert(cout == 1'b1);

        $finish();
    }
}

