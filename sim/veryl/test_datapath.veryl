        c_if.gpr_destination_selector = gpr_destination_selector_t::GPR2;

        u_clock.next(1);

        $assert(c_if.ir == 16'h0);
        $assert(c_if.alu_cout == 16'h0);
        $assert(c_if.shifter_cout == 16'h0);
        $assert(c_if.lbus_msb == 1'b0);
        $assert(c_if.rbus_msb == 1'b1);
        $assert(c_if.rbus_lower == 8'h82);
        $assert(c_if.abus == 16'h95E4);
        $assert(c_if.sbus_msb == 1'b1);
        $assert(mm_addr == 16'h0140);
        $assert(mm_dout == 16'h1166);
        $assert(of_din == 8'h66);

        $finish();
    }
}

