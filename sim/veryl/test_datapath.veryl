        c_if.set_pc                   = 1'h0;
        c_if.literal                  = 16'h0;
        c_if.flags                    = 4'h0;
        c_if.cin                      = 1'h0;
        c_if.inbus_valid              = 1'h0;
        mm_din                        = 16'h0;
        if_dout                       = 8'h0;

