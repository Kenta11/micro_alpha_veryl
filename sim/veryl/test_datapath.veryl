        c_if.shifter_operation        = shifter_operation_t::NOP;
        c_if.gpr_destination_selector = gpr_destination_selector_t::NONE;
        c_if.ir_source_selector       = ir_source_selector_t::NO_OPERATION;
        c_if.set_mar                  = 1'h0;
        c_if.set_fsr                  = 1'h0;
        c_if.set_pc                   = 1'h0;
        c_if.literal                  = 16'h0;
        c_if.flags                    = 4'h0;
        c_if.cin                      = 1'h0;
        c_if.inbus_valid              = 1'h0;
        mm_din                        = 16'h0;
        if_dout                       = 8'h0;

        u_reset.assert(1);

        u_clock.next(1);

        c_if.rbus_source_selector     = rbus_source_selector_t::LLT;
        c_if.gpr_destination_selector = gpr_destination_selector_t::GPR0;
        c_if.literal                  = 16'hBEEF;

        u_clock.next(1);

        c_if.rbus_source_selector     = rbus_source_selector_t::NRB;
        c_if.lbus_source_selector     = lbus_source_selector_t::R0;
