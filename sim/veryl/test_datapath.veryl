        c_if.alu_operation            = alu_operation_t::NOP;
        c_if.shifter_operation        = shifter_operation_t::NOP;
        c_if.gpr_destination_selector = gpr_destination_selector_t::NONE;
        c_if.ir_source_selector       = ir_source_selector_t::NO_OPERATION;
        c_if.set_mar                  = 1'h0;
        c_if.set_fsr                  = 1'h0;
        c_if.set_pc                   = 1'h0;
        c_if.literal                  = 16'h0;
        c_if.flags                    = 4'h0;
        c_if.cin                      = 1'h0;
        c_if.inbus_valid              = 1'h0;
        mm_din                        = 16'h0;
        if_dout                       = 8'h0;

        u_reset.assert(1);

        u_clock.next(1);

        c_if.rbus_source_selector     = rbus_source_selector_t::LLT;
        c_if.gpr_destination_selector = gpr_destination_selector_t::GPR2;
        c_if.literal                  = 16'hBEEF;

        u_clock.next(1);

        c_if.gpr_destination_selector = gpr_destination_selector_t::GPR4;
        c_if.literal                  = 16'h0200;

        u_clock.next(1);

        c_if.lbus_source_selector     = lbus_source_selector_t::R4;
        c_if.rbus_source_selector     = rbus_source_selector_t::NRB;
        c_if.gpr_destination_selector = gpr_destination_selector_t::NONE;
        c_if.ir_source_selector       = ir_source_selector_t::SET_IR;

        u_clock.next(1);

        c_if.lbus_source_selector     = lbus_source_selector_t::RB;
        c_if.gpr_destination_selector = gpr_destination_selector_t::NONE;
        c_if.ir_source_selector       = ir_source_selector_t::NO_OPERATION;

        u_clock.next(1);

        $assert(c_if.ir == 16'h0200);
        $assert(c_if.alu_cout == 16'h0);
        $assert(c_if.shifter_cout == 16'h0);
        $assert(c_if.lbus_msb == 1'b1);
        $assert(c_if.rbus_msb == 1'b0);
        $assert(c_if.rbus_lower == 8'h0);
        $assert(c_if.abus == 16'hBEEF);
        $assert(c_if.sbus_msb == 1'b1);
        $assert(mm_addr == 16'h0140);
        $assert(mm_dout == 16'hBEEF);
        $assert(of_din == 8'hEF);

        $finish();
    }
}

