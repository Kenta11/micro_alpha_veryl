#[test(test_shifter_swap)]
module test_shifter_swap {
    import machine_data_pkg::*;
    import shifter_pkg::*;

    inst u_clock: $tb::clock_gen;

    var operation: shifter_operation_t  ;
    var r#in     : micro1_machine_word_t;
    var cin      : logic                ;
    var out      : micro1_machine_word_t;
    var cout     : logic                ;

    inst dut: shifter ( operation, r#in, cin, out, cout );

    initial {
        operation = shifter_operation_t::SWAP;
        r#in      = 16'h0123;
        cin       = 1'b0;

        u_clock.next(1);

        $assert(out == 16'h2301);
        $assert(cout == 1'b0);

        $finish();
    }
}

#[test(test_shifter_nop)]
module test_shifter_nop {
    import machine_data_pkg::*;
