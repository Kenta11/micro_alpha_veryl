#[test(test_shifter_shift_left_arithmetically_without_carry)]
module test_shifter_shift_left_arithmetically_without_carry {
    import machine_data_pkg::*;
    import shifter_pkg::*;

    inst u_clock: $tb::clock_gen;

    var operation: shifter_operation_t  ;
    var r#in     : micro1_machine_word_t;
    var cin      : logic                ;
    var out      : micro1_machine_word_t;
    var cout     : logic                ;

    inst dut: shifter ( operation, r#in, cin, out, cout );

    initial {
        operation = shifter_operation_t::LEFT_ARITHMETICALLY;
        r#in      = 16'hFFFF;
        cin       = 1'b0;

        u_clock.next(1);

        $assert(out == 16'hFFFE);
        $assert(cout == 1'b1);

        $finish();
    }
}

