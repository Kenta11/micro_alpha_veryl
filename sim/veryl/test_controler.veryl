        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        u_clock.next(1);

        // phase T5
