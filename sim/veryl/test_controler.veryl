    var if_re   : logic                   ;
    var of_full : logic                   ;
    var of_we   : logic                   ;
    var led_hlt : logic                   ;
    var led_ov  : logic                   ;

    inst dut: controler (
        clk     : u_clock,
        rst     : u_reset,
        c_if    : c_if   ,
        cm_addr          ,
        cm_din           ,
        mm_we            ,
