    initial {
        c_if.ir           = 16'h0;
        c_if.alu_cout     = 1'b0;
        c_if.shifter_cout = 1'b0;
        c_if.lbus_msb     = 1'b0;
        c_if.rbus_msb     = 1'b0;
        c_if.rbus_lower   = 8'h0;
        c_if.abus         = 16'h0;
        c_if.sbus_msb     = 1'b0;
        cm_din            = 40'hFFFFFFFFFF;
        if_empty          = 1'b1;
        of_full           = 1'b1;

        u_reset.assert(1);

        // phase INIT
        cm_din = 40'hF0FFFFFE00;

        u_clock.next(1);

        // phase T1
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::NLB);
