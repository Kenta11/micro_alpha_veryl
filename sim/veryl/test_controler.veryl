#[test(test_controler_lbus)]
module test_controler_lbus {
    import alu_pkg::*;
    import control_data_pkg::*;
    import gpr_destination_selector_pkg::*;
    import ir_source_selector_pkg::*;
    import lbus_source_selector_pkg::*;
    import rbus_source_selector_pkg::*;
    import shifter_pkg::*;

    inst u_clock: $tb::clock_gen;
    inst u_reset: $tb::reset_gen ( clk: u_clock );

    inst c_if: control_if;

    var cm_addr : micro1_control_address_t;
    var cm_din  : micro1_control_word_t   ;
    var mm_we   : logic                   ;
    var if_empty: logic                   ;
    var if_re   : logic                   ;
    var of_full : logic                   ;
    var of_we   : logic                   ;
    var led_hlt : logic                   ;
    var led_ov  : logic                   ;

    inst dut: controler (
        clk     : u_clock,
        rst     : u_reset,
        c_if    : c_if   ,
        cm_addr          ,
        cm_din           ,
        mm_we            ,
        if_empty         ,
        if_re            ,
        of_full          ,
        of_we            ,
        led_hlt          ,
        led_ov           ,
    );

    initial {
        c_if.ir           = 16'h0;
        c_if.alu_cout     = 1'b0;
        c_if.shifter_cout = 1'b0;
        c_if.lbus_msb     = 1'b0;
        c_if.rbus_msb     = 1'b0;
        c_if.rbus_lower   = 8'h0;
        c_if.abus         = 16'h0;
        c_if.sbus_msb     = 1'b0;
        cm_din            = 40'hFFFFFFFFFF;
        if_empty          = 1'b1;
        of_full           = 1'b1;

        u_reset.assert(1);

        // phase INIT
        cm_din = 40'h0FFFFFFE00;

        u_clock.next(1);

        // phase T1
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::R0);
        $assert(c_if.rbus_source_selector == rbus_source_selector_t::NRB);
        $assert(c_if.alu_operation == alu_operation_t::NOP);
        $assert(c_if.shifter_operation == shifter_operation_t::NOP);
        $assert(c_if.gpr_destination_selector == gpr_destination_selector_t::NONE);
        $assert(c_if.ir_source_selector == ir_source_selector_t::NO_OPERATION);
        $assert(c_if.set_mar == 1'b0);
        $assert(c_if.set_fsr == 1'b0);
        $assert(c_if.set_pc == 1'b0);
        $assert(c_if.literal == 16'hFE00);
        $assert(c_if.flags == 4'b0000);
        $assert(c_if.cin == 1'b0);
        $assert(c_if.inbus_valid == 1'b0);
        $assert(cm_addr == 12'h000);
        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        u_clock.next(1);

        // phase T2
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::R0);
        $assert(c_if.rbus_source_selector == rbus_source_selector_t::NRB);
        $assert(c_if.alu_operation == alu_operation_t::NOP);
        $assert(c_if.shifter_operation == shifter_operation_t::NOP);
        $assert(c_if.gpr_destination_selector == gpr_destination_selector_t::NONE);
        $assert(c_if.ir_source_selector == ir_source_selector_t::NO_OPERATION);
        $assert(c_if.set_mar == 1'b0);
        $assert(c_if.set_fsr == 1'b0);
        $assert(c_if.set_pc == 1'b0);
        $assert(c_if.literal == 16'hFE00);
        $assert(c_if.flags == 4'b0000);
        $assert(c_if.cin == 1'b0);
        $assert(c_if.inbus_valid == 1'b0);
        $assert(cm_addr == 12'h000);
        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        u_clock.next(1);

        // phase T3
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::R0);
        $assert(c_if.rbus_source_selector == rbus_source_selector_t::NRB);
        $assert(c_if.alu_operation == alu_operation_t::NOP);
        $assert(c_if.shifter_operation == shifter_operation_t::NOP);
        $assert(c_if.gpr_destination_selector == gpr_destination_selector_t::NONE);
        $assert(c_if.ir_source_selector == ir_source_selector_t::NO_OPERATION);
        $assert(c_if.set_mar == 1'b0);
        $assert(c_if.set_fsr == 1'b0);
        $assert(c_if.set_pc == 1'b0);
        $assert(c_if.literal == 16'hFE00);
        $assert(c_if.flags == 4'b0000);
        $assert(c_if.cin == 1'b0);
        $assert(c_if.inbus_valid == 1'b0);
        $assert(cm_addr == 12'h001);
        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        u_clock.next(1);

        // phase T4
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::R0);
        $assert(c_if.rbus_source_selector == rbus_source_selector_t::NRB);
        $assert(c_if.alu_operation == alu_operation_t::NOP);
        $assert(c_if.shifter_operation == shifter_operation_t::NOP);
        $assert(c_if.gpr_destination_selector == gpr_destination_selector_t::NONE);
        $assert(c_if.ir_source_selector == ir_source_selector_t::NO_OPERATION);
        $assert(c_if.set_mar == 1'b0);
        $assert(c_if.set_fsr == 1'b0);
        $assert(c_if.set_pc == 1'b0);
        $assert(c_if.literal == 16'hFE00);
        $assert(c_if.flags == 4'b0000);
        $assert(c_if.cin == 1'b0);
        $assert(c_if.inbus_valid == 1'b0);
        $assert(cm_addr == 12'h001);
        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        u_clock.next(1);

        // phase T5
        $assert(c_if.lbus_source_selector == lbus_source_selector_t::R0);
        $assert(c_if.rbus_source_selector == rbus_source_selector_t::NRB);
        $assert(c_if.alu_operation == alu_operation_t::NOP);
        $assert(c_if.shifter_operation == shifter_operation_t::NOP);
        $assert(c_if.gpr_destination_selector == gpr_destination_selector_t::NONE);
        $assert(c_if.ir_source_selector == ir_source_selector_t::NO_OPERATION);
        $assert(c_if.set_mar == 1'b0);
        $assert(c_if.set_fsr == 1'b0);
        $assert(c_if.set_pc == 1'b0);
        $assert(c_if.literal == 16'hFE00);
        $assert(c_if.flags == 4'b0000);
        $assert(c_if.cin == 1'b0);
        $assert(c_if.inbus_valid == 1'b0);
        $assert(cm_addr == 12'h001);
        $assert(mm_we == 1'b0);
        $assert(if_re == 1'b0);
        $assert(of_we == 1'b0);
        $assert(led_hlt == 1'b0);
        $assert(led_ov == 1'b0);

        $finish();
    }
}

