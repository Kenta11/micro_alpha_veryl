#[test(test_controler_mm_wm)]
module test_controler_mm_wm {
    import alu_pkg::*;
    import control_data_pkg::*;
    import gpr_destination_selector_pkg::*;
    import ir_source_selector_pkg::*;
    import lbus_source_selector_pkg::*;
    import rbus_source_selector_pkg::*;
    import shifter_pkg::*;

    inst u_clock: $tb::clock_gen;
    inst u_reset: $tb::reset_gen ( clk: u_clock );

    inst c_if: control_if;

    var cm_addr : micro1_control_address_t;
    var cm_din  : micro1_control_word_t   ;
    var mm_we   : logic                   ;
    var if_empty: logic                   ;
    var if_re   : logic                   ;
    var of_full : logic                   ;
    var of_we   : logic                   ;
    var led_hlt : logic                   ;
    var led_ov  : logic                   ;

    inst dut: controler (
        clk     : u_clock,
        rst     : u_reset,
        c_if    : c_if   ,
        cm_addr          ,
        cm_din           ,
        mm_we            ,
        if_empty         ,
        if_re            ,
        of_full          ,
        of_we            ,
        led_hlt          ,
        led_ov           ,
    );

